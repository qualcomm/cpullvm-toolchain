{
    "args": {
        "common": {
            "TARGET_ARCH": "riscv32",
            "VARIANT": "riscv32ima_zinx_zve64x_zvl128b_nopic_xqci_ilp32",
            "COMPILE_FLAGS": "-march=rv32ima_zawrs_zacas_zabha_zba_zbb_zbs_zca_zcb_zilsd_zclsd_zdinx_zhinx_zfinx_xqci_xqccmp_xqccmt0p1_zve64x_zvl128b -menable-experimental-extensions -mabi=ilp32 -fno-pic -fcf-protection=none",
            "ENABLE_EXCEPTIONS": "OFF",
            "ENABLE_RTTI": "OFF",
            "TEST_EXECUTOR": "qemu",
            "QEMU_MACHINE": "virt",
            "QEMU_CPU": "rv32,m=true,a=true,f=false,d=false,zfa=false,zcd=false,zawrs=true,zacas=true,zabha=true,zba=true,zbb=true,zbs=true,zca=true,zcb=true,zilsd=true,zclsd=true,zdinx=true,zhinx=true,zfinx=true,xqci=true,xqccmp=true,xqccmt=true,zve64x=true,vlen=128,elen=64",
            "QEMU_PARAMS": "-bios none",
            "FLASH_ADDRESS": "0x80000000",
            "FLASH_SIZE": "0x00400000",
            "RAM_ADDRESS": "0x80400000",
            "RAM_SIZE": "0x00a00000",
            "LIBRARY_BUILD_TYPE": "minsizerelease"
        },
        "picolibc": {
            "ENABLE_CXX_LIBS": "ON",
            "ENABLE_LIBC_TESTS": "ON",
            "ENABLE_COMPILER_RT_TESTS": "ON",
            "ENABLE_LIBCXX_TESTS": "ON"
        }
    }
}
