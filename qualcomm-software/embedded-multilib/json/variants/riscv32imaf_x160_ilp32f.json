{
    "args": {
        "common": {
            "TARGET_ARCH": "riscv32",
            "VARIANT": "riscv32imaf_x160_ilp32f",
            "COMPILE_FLAGS": "-mcpu=sifive-x160 -menable-experimental-extensions -mabi=ilp32f -fPIC",
            "ENABLE_EXCEPTIONS": "OFF",
            "ENABLE_RTTI": "OFF",
            "TEST_EXECUTOR": "qemu",
            "QEMU_MACHINE": "virt",
            "QEMU_CPU": "rv32,m=true,a=true,f=true,c=true,d=false,zcd=false,zba=true,zbb=true,zbs=true,zfh=true,zfa=true,zfbfmin=true,zcb=true,zce=true,zcf=true,zcmop=true,zcmp=true,zcmt=true,zawrs=true,zicbom=true,zicbop=true,zicboz=true,zicfilp=true,zicond=true,zifencei=true,zihintntl=true,zihintpause=true,zihpm=true,zimop=true,zkt=true,zvbb=true,zve32f=true,zve32x=true,zvfh=true,zvfbfmin=true,zvfbfwma=true,zvkt=true,vlen=128,elen=32",
            "QEMU_PARAMS": "-bios none",
            "FLASH_ADDRESS": "0x80000000",
            "FLASH_SIZE": "0x00400000",
            "RAM_ADDRESS": "0x80400000",
            "RAM_SIZE": "0x00a00000",
            "LIBRARY_BUILD_TYPE": "minsizerelease"
        },
        "picolibc": {
            "ENABLE_CXX_LIBS": "ON",
            "ENABLE_LIBC_TESTS": "ON",
            "ENABLE_COMPILER_RT_TESTS": "OFF",
            "ENABLE_LIBCXX_TESTS": "OFF"
        }
    }
}
