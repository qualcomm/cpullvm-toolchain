+# SEC:  .mybaz            PROGBITS
+
+#--- 1.ll
+
+define internal i32 @foo(i32 %x) nounwind section ".text.foo" {
+  %m = mul i32 %x, 10
+  ret i32 %m
+}
+
+define i32 @bar(i32 %y) nounwind section ".text.bar" {
+  %m = mul i32 %y, 10
+  %v = call i32 @foo(i32 %m)
+  ret i32 %v
