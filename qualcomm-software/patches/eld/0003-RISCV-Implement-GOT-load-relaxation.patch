diff --git a/test/RISCV/standalone/Relaxation/GOT_LOAD_RELAX/Inputs/nonsequential.S b/test/RISCV/standalone/Relaxation/GOT_LOAD_RELAX/Inputs/nonsequential.S
new file mode 100644
index 00000000..95e51434
--- /dev/null
+++ b/test/RISCV/standalone/Relaxation/GOT_LOAD_RELAX/Inputs/nonsequential.S
@@ -0,0 +1,40 @@
+.option relax
+.option pic
+
+#ifdef USE_REL
+.data
+.global var
+var:
+.word 10
+
+.global var2
+var2:
+.word 5
+#endif
+
+## The relaxation should work with unrelated instructions
+## and relocations interspersed.
+.text
+.global foo
+foo:
+.La:
+    auipc a0, %got_pcrel_hi(var)
+    nop
+    nop
+    lw a3, %pcrel_lo(.La)(a0)
+    lga a1, var2
+    lw a2, %pcrel_lo(.La)(a0)
+
+## Check that the relaxation is able to cope with the HI/LO relocations
+## not necessarily being processed in that order.
+.global bar
+bar:
+    j .Lgotpcrel_hi1
+
+.Lpcrel_lo1:
+    lw a0, %pcrel_lo(.Lgotpcrel_hi1)(a0)
+    ret
+
+.Lgotpcrel_hi1:
+    auipc a0, %got_pcrel_hi(var2)
+    j .Lpcrel_lo1
diff --git a/test/RISCV/standalone/Relaxation/GOT_LOAD_RELAX/Inputs/partial_relax.s b/test/RISCV/standalone/Relaxation/GOT_LOAD_RELAX/Inputs/partial_relax.s
new file mode 100644
index 00000000..bf1151fb
--- /dev/null
+++ b/test/RISCV/standalone/Relaxation/GOT_LOAD_RELAX/Inputs/partial_relax.s
@@ -0,0 +1,53 @@
+.option norelax
+.option pic
+
+.data
+.global rel_var
+rel_var:
+.word 10
+
+.text
+.global foo
+foo:
+## Only LO is marked with RELAX. No relaxation
+.La_abs:
+    auipc a1, %got_pcrel_hi(abs_var)
+    lw    a1, %pcrel_lo(.La_abs)(a1)
+    .reloc .-4, R_RISCV_RELAX
+
+.La_rel:
+    auipc a2, %got_pcrel_hi(rel_var)
+    lw    a2, %pcrel_lo(.La_rel)(a2)
+    .reloc .-4, R_RISCV_RELAX
+
+## Only HI is marked with RELAX. No relaxation.
+.Lb_abs:
+    auipc a1, %got_pcrel_hi(abs_var)
+    .reloc .-4, R_RISCV_RELAX
+    lw    a1, %pcrel_lo(.Lb_abs)(a1)
+
+.Lb_rel:
+    auipc a2, %got_pcrel_hi(rel_var)
+    .reloc .-4, R_RISCV_RELAX
+    lw    a2, %pcrel_lo(.Lb_rel)(a2)
+
+## Multiple LOs for one HI, not all are marked RELAX.
+## There should be no relaxation
+.Lc_abs:
+    auipc a1, %got_pcrel_hi(abs_var)
+    .reloc .-4, R_RISCV_RELAX
+    lw    a2, %pcrel_lo(.Lc_abs)(a1)
+    .reloc .-4, R_RISCV_RELAX
+    lw    a3, %pcrel_lo(.Lc_abs)(a1)
+
+.Lc_rel:
+    auipc a1, %got_pcrel_hi(rel_var)
+    .reloc .-4, R_RISCV_RELAX
+    lw    a2, %pcrel_lo(.Lc_rel)(a1)
+    .reloc .-4, R_RISCV_RELAX
+    lw    a3, %pcrel_lo(.Lc_rel)(a1)
+
+## HI with RELAX but no LO. No relaxation.
+.Ld_rel:
+    auipc a1, %got_pcrel_hi(rel_var)
+    .reloc .-4, R_RISCV_RELAX
