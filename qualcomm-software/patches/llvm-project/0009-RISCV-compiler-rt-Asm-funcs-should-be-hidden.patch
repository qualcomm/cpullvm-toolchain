--- a/compiler-rt/lib/builtins/riscv/int_mul_impl.inc
+++ b/compiler-rt/lib/builtins/riscv/int_mul_impl.inc
@@ -10,24 +10,22 @@
 //
 //===----------------------------------------------------------------------===//
 
+#include "../assembly.h"
+
 #ifndef __mulxi3
 #error "__mulxi3 must be defined to use this generic implementation"
 #endif
 
-	.text
-	.align 2
-
-	.globl __mulxi3
-	.type  __mulxi3, @function
-__mulxi3:
-	mv     a2, a0
-	mv     a0, zero
-.L1:
-	andi   a3, a1, 1
-	beqz   a3, .L2
-	add    a0, a0, a2
-.L2:
-	srli   a1, a1, 1
-	slli   a2, a2, 1
-	bnez   a1, .L1
-	ret
+DEFINE_COMPILERRT_FUNCTION(__mulxi3)
+  mv     a2, a0
+  mv     a0, zero
+LOCAL_LABEL(loop):
+  andi   a3, a1, 1
+  beqz   a3, LOCAL_LABEL(cond_add)
+  add    a0, a0, a2
+LOCAL_LABEL(cond_add):
+  srli   a1, a1, 1
+  slli   a2, a2, 1
+  bnez   a1, LOCAL_LABEL(loop)
+  ret
+END_COMPILERRT_FUNCTION(__mulxi3)
