+  %a2 = lshr i32 %a0, 29
+  %a3 = or i32 %a1, %a2
+  %a4 = xor i32 %a3, %b0
+  %result = add i32 %a4, 2
+  ret i32 %result
+}
+
+define i32 @shared_2(i32 %a, i32 %b) noinline nounwind section ".sec_shared" {
+; CHECK-LABEL: shared_2:
