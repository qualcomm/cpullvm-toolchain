+  %result = add i32 %a4, 5
+  ret i32 %result
+}
+
+define i32 @plain_2(i32 %a, i32 %b) noinline nounwind {
+; FS: .section .text.plain_2,"ax",@progbits
+; CHECK-LABEL: plain_2:
+; CHECK: call t0, OUTLINED_FUNCTION_1
+  %a0 = xor i32 %a, %b
+  %b0 = add i32 %b, %a0
+  %a1 = shl i32 %a0, 3
+  %a2 = lshr i32 %a0, 29
+  %a3 = or i32 %a1, %a2
+  %a4 = xor i32 %a3, %b0
+  %result = add i32 %a4, 6
+  ret i32 %result
+}
