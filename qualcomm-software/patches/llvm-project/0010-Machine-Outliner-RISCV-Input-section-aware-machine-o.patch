+  %a1 = shl i32 %a0, 3
+  %a2 = lshr i32 %a0, 29
+  %a3 = or i32 %a1, %a2
+  %a4 = xor i32 %a3, %b0
+  %result = add i32 %a4, 3
+  ret i32 %result
+}
+
