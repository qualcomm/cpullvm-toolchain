 llvm/lib/Target/RISCV/RISCVFrameLowering.cpp  |  105 +-
 .../Target/RISCV/RISCVMachineFunctionInfo.cpp |   18 +
 .../Target/RISCV/RISCVMachineFunctionInfo.h   |    7 +
 llvm/test/CodeGen/RISCV/saverestore-scs.ll    |   15 +-
 .../CodeGen/RISCV/shadow-stack-frame-opts.ll  | 1871 +++++++++++++++++
 5 files changed, 1971 insertions(+), 45 deletions(-)
 create mode 100644 llvm/test/CodeGen/RISCV/shadow-stack-frame-opts.ll

