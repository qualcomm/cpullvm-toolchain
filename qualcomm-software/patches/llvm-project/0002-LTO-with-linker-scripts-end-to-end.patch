+target triple = "aarch64-unknown-linux-gnu"
+
+@z = global i32 1, section ".data.z", align 4
+@another_common = global [100 x i32] zeroinitializer, section ".sdata.another_common", align 16
+
+#--- script.t
+NOCROSSREFS(  .baz .text .bss .data .xsection .zsection)
+SECTIONS {
+  .zsection : { *(.data.z) }
+  .xsection : { *(.data.x) }
+  .baz : { *(.text.baz) }
+  .text : { *(.text.*) }
+  .bss : { *(.sdata*) }
