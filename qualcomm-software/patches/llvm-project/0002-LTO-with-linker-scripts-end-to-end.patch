+.text
+.section .text,"ax",@progbits
+.globl main
+.type main,@function
+main:
+  bl foo
+  mov x0, xzr
+  bl bar
+  mov x0, xzr
+  ret
+.size main, .-main
+
+#--- script.t
+SECTIONS {
+.myfoo : { *1.o*(.foo) }
+.mybar : { *2.o*(.foo) }
+.main : { *(.text) }
